<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdminController.adminProduct">

   <children>

      <!-- ================= SIDEBAR ================= -->
      <VBox fx:id="panel" alignment="TOP_CENTER" fillWidth="true" prefWidth="220.0" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

         <children>
            <ImageView fx:id="logo" fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../image/image6.jpg" />
               </image>
            </ImageView>

            <Label fx:id="textPanel" alignment="CENTER" maxWidth="Infinity" text="Admin Panel" />

            <VBox maxWidth="Infinity" spacing="6.0">
               <children>
                  <Button fx:id="dashboard" maxWidth="Infinity" onAction="#dashboardButtonAction" styleClass="nav-btn" text="Dashboard">
                     <graphic>
                        <ImageView fitHeight="20" fitWidth="20">
                           <image>
                              <Image url="@../image/icons8-dashboard-24.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="productBtn" maxWidth="Infinity" onAction="#productButtonAction" styleClass="nav-btn" text="Products">
                     <graphic>
                        <ImageView fitHeight="20" fitWidth="20">
                           <image>
                              <Image url="@../image/icons8-products-24.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="salesBtn" maxWidth="Infinity" onMouseClicked="#saleHandleBtn" styleClass="nav-btn" text="Sales">
                     <graphic>
                        <ImageView fitHeight="20" fitWidth="20">
                           <image>
                              <Image url="@../image/icons8-sales-24.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="userBtn" maxWidth="Infinity" onAction="#userButtonAction" styleClass="nav-btn" text="Users">
                     <graphic>
                        <ImageView fitHeight="20" fitWidth="20">
                           <image>
                              <Image url="@../image/icons8-user-24.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#logoutButtonAction" styleClass="nav-btn1" text="Logout">
               <graphic>
                  <ImageView fitHeight="20" fitWidth="20">
                     <image>
                        <Image url="@../image/icons8-logout-24.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>

         </children>
      </VBox>


      <!-- ================= TITLE ================= -->
      <Label layoutX="240.0" layoutY="20.0" styleClass="page-title" text="Products" />


      <!-- ================= PRODUCT FORM ================= -->
      <TextField fx:id="nameField" layoutX="240.0" layoutY="61.0" prefWidth="200" promptText="Product Name" />

      <ComboBox fx:id="typeCombo" layoutX="240.0" layoutY="106.0" prefWidth="200" promptText="Type" />

      <TextField fx:id="priceField" layoutX="240" layoutY="160" prefWidth="200" promptText="Price" />

      <TextField fx:id="stockField" layoutX="240.0" layoutY="210.0" prefWidth="200" promptText="Stock" />

      <TextArea fx:id="descField" layoutX="240.0" layoutY="259.0" prefHeight="70" prefWidth="200" promptText="Description" />


      <!-- ================= IMAGE ================= -->
      <ImageView fx:id="productImage" fitHeight="120" fitWidth="120" layoutX="470" layoutY="80" styleClass="image-preview" />

      <Button layoutX="470" layoutY="210" onAction="#chooseImage" styleClass="btn-secondary" text="Choose Image" />


      <!-- ================= CRUD BUTTONS ================= -->
      <Button layoutX="245.0" layoutY="342.0" onAction="#addProduct" prefHeight="37.0" prefWidth="86.0" styleClass="btn-primary" text="Add" />

      <Button layoutX="340.0" layoutY="341.0" onAction="#updateProduct" prefHeight="39.0" prefWidth="92.0" styleClass="btn-secondary" text="Update" />

      <Button layoutX="440.0" layoutY="342.0" onAction="#deleteProduct" prefHeight="37.0" prefWidth="92.0" styleClass="btn-danger" text="Delete" />


      <!-- ================= TABLE ================= -->
      <TableView fx:id="table" layoutX="240.0" layoutY="394.0" prefHeight="193.0" prefWidth="540">

         <columns>
            <TableColumn fx:id="colId" prefWidth="50" text="ID" />
            <TableColumn fx:id="colName" prefWidth="185.0" text="Name" />
            <TableColumn fx:id="colType" prefWidth="100.0" text="Type" />
            <TableColumn fx:id="colStock" prefWidth="103.0" text="Stock" />
            <TableColumn fx:id="colPrice" prefWidth="100.0" text="Price" />
         </columns>

      </TableView>

   </children>
</AnchorPane>
