<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/user.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UserController.userCart">

    <children>

        <HBox fx:id="navPanel" alignment="CENTER_LEFT" prefHeight="80.0" spacing="16.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <children>
                <ImageView fx:id="navLogo" fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                    <image>
                        <Image url="@../image/image6.jpg" />
                    </image>
                    <HBox.margin>
                        <Insets left="22.0" />
                    </HBox.margin>
                </ImageView>

                <Label styleClass="brand-title" text="Melynal Trading" />

                <Label fx:id="homeBtn" onMouseClicked="#homeHandleBtn" styleClass="nav-item" text="Home" />
                <Label fx:id="productBtn" onMouseClicked="#productHandleBtn" styleClass="nav-item" text="Products" />
                <Label fx:id="aboutBtn" onMouseClicked="#aboutHandleBtn" style="-fx-text-fill: white;" styleClass="nav-item" text="About" />

                <Region HBox.hgrow="ALWAYS" />

                <StackPane onMouseClicked="#openCartPage" prefHeight="43.0" prefWidth="44.0" styleClass="cart-chip">
                    <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                        <image>
                            <Image url="@../image/icons8-cart-24.png" />
                        </image>
                    </ImageView>
                    <Label fx:id="cartBadge" text="0" visible="false">
                        <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                        <StackPane.margin>
                            <Insets right="-8.0" top="-10.0" />
                        </StackPane.margin>
                    </Label>
                </StackPane>

                <Label fx:id="profileBtn" onMouseClicked="#profileHandlebtn" styleClass="nav-item" text="Profile" />
                <Label fx:id="logoutBtn" onMouseClicked="#handleLogoutBtn" styleClass="nav-item" text="Logout">
                    <HBox.margin>
                        <Insets right="22.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>

        <VBox spacing="10.0" styleClass="cart-pane surface" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="94.0">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="page-title" text="My Cart" />
                    </children>
                </HBox>

                <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="cImage" prefWidth="70" text="Img" />
                        <TableColumn fx:id="cName" prefWidth="220" text="Item" />
                        <TableColumn fx:id="cPrice" prefWidth="110" text="Price" />
                        <TableColumn fx:id="cQty" prefWidth="160" text="Qty" />
                        <TableColumn fx:id="cSubtotal" prefWidth="170" text="Subtotal" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label styleClass="total-label" text="Total:" />
                        <Label fx:id="totalLabel" styleClass="total-value" text="PHP 0.00" />
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <Button onAction="#removeSelected" prefWidth="170.0" styleClass="btn-secondary" text="Remove Selected" />
                        <Button onAction="#checkout" prefWidth="150.0" styleClass="btn-primary" text="Checkout" />
                    </children>
                </HBox>

                <Label fx:id="cartMsg" styleClass="hint-text" text="" />
            </children>
        </VBox>

    </children>
</AnchorPane>
