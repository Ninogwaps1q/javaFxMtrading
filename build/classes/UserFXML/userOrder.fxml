<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/user.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UserController.userOrder">
    <children>
        <HBox fx:id="navPanel" alignment="CENTER_LEFT" prefHeight="80.0" spacing="16.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fx:id="navLogo" fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                    <image>
                        <Image url="@../image/image6.jpg" />
                    </image>
                    <HBox.margin>
                        <Insets left="22.0" />
                    </HBox.margin>
                </ImageView>

                <Label styleClass="brand-title" text="Melynal Trading" />

                <Label onMouseClicked="#homeHandleBtn" styleClass="nav-item" text="Home" />
                <Label onMouseClicked="#productHandleBtn" styleClass="nav-item" text="Products" />
                <Label onMouseClicked="#aboutHandleBtn" styleClass="nav-item" text="About" />
                <Label onMouseClicked="#orderHandleBtn" style="-fx-font-weight: 900;" styleClass="nav-item nav-item-active" text="Orders" />

                <Region HBox.hgrow="ALWAYS" />

                <Label onMouseClicked="#profileHandlebtn" styleClass="nav-item" text="Profile" />
                <Label onMouseClicked="#handleLogoutBtn" styleClass="nav-item" text="Logout">
                    <HBox.margin>
                        <Insets right="22.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>

        <VBox spacing="12.0" styleClass="orders-root" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="orders-hero surface">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orders-title" text="Track Your Orders" />
                                <Label styleClass="orders-subtitle" text="Check order progress from pending to ready for delivery and delivered." />
                                <Label fx:id="ordersMsg" styleClass="orders-message" text="" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <children>
                                <Label styleClass="orders-meta-label" text="Total Orders" />
                                <Label fx:id="totalOrdersLabel" styleClass="orders-meta-value" text="0" />
                                <Label styleClass="orders-meta-label" text="Total Spend" />
                                <Label fx:id="totalSpendLabel" styleClass="orders-meta-value" text="PHP 0.00" />
                                <Button onAction="#refreshOrdersAction" styleClass="btn-secondary orders-refresh-btn" text="Refresh" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="12.0">
                    <children>
                        <VBox spacing="4.0" styleClass="orders-stat-card orders-stat-pending" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orders-stat-label" text="Pending" />
                                <Label fx:id="pendingCountLabel" styleClass="orders-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="orders-stat-card orders-stat-shipped" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orders-stat-label" text="Shipped" />
                                <Label fx:id="shippedCountLabel" styleClass="orders-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="orders-stat-card orders-stat-ready" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orders-stat-label" text="Ready To Deliver" />
                                <Label fx:id="readyCountLabel" styleClass="orders-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="orders-stat-card orders-stat-delivered" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orders-stat-label" text="Delivered" />
                                <Label fx:id="deliveredCountLabel" styleClass="orders-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="orders-stat-card orders-stat-cancelled" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orders-stat-label" text="Cancelled" />
                                <Label fx:id="cancelledCountLabel" styleClass="orders-stat-value" text="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" styleClass="orders-table-wrap surface" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="page-title" text="Order History" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="viewDetailsBtn" disable="true" onAction="#viewOrderDetailsAction" styleClass="btn-secondary" text="View Details" />
                                <Button fx:id="orderReceivedBtn" disable="true" onAction="#receiveOrderAction" styleClass="btn-primary" text="Order Received" />
                                <Label styleClass="total-label" text="Latest purchases first" />
                            </children>
                        </HBox>

                        <TableView fx:id="ordersTable" styleClass="orders-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="orderIdCol" prefWidth="170.0" text="Order ID" />
                                <TableColumn fx:id="amountCol" prefWidth="220.0" text="Amount" />
                                <TableColumn fx:id="statusCol" prefWidth="260.0" text="Status" />
                                <TableColumn fx:id="dateCol" prefWidth="280.0" text="Date" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
