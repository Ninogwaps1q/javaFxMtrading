<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="AnchorPane" prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/cashier.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cashierController.cashierDashboard">

   <children>

      <!-- Sidebar -->
      <VBox fx:id="panel" alignment="TOP_CENTER" fillWidth="true" prefWidth="220.0" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

         <children>
            <ImageView fx:id="logo" fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../image/image6.jpg" />
               </image>
            </ImageView>

            <Label fx:id="textPanel" alignment="CENTER" maxWidth="Infinity" text="Cashier Panel" />

            <VBox maxWidth="Infinity" spacing="6.0">
               <children>
                  <Button fx:id="dashboard" maxWidth="Infinity" onAction="#dashboardButtonAction" styleClass="nav-btn" text="Dashboard">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../image/icons8-dashboard-24.png" />
                           </image>
                           <viewport>
                              <Rectangle2D />
                           </viewport>
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="productBtn" maxWidth="Infinity" onAction="#productButtonAction" styleClass="nav-btn" text="Order">
                     <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../image/icons8-add-shopping-cart-32.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="salesBtn" maxWidth="Infinity" onAction="#orderButtonAction" onMouseClicked="#saleHandleBtn" styleClass="nav-btn" text="Sales Product">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../image/icons8-sales-24.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#logoutButtonAction" styleClass="nav-btn1" text="Logout">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../image/icons8-logout-24.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </VBox>

      <!-- Main content -->
      <VBox spacing="14.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0">
         <children>
            <Label styleClass="page-title" text="Dashboard" />

            <!-- Profile Summary -->
            <VBox maxWidth="Infinity" prefHeight="170.0" spacing="10.0" styleClass="surface dashboard-card">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <children>
                        <ImageView fx:id="userprofile" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../image/icons8-profile-50.png" />
                           </image>
                        </ImageView>

                        <VBox spacing="6.0">
                           <children>
                              <Label fx:id="nameLabel" text="Name" />
                              <Label fx:id="emailLabel" text="Email" />
                              <Label fx:id="roleLabel" text="Role" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>

</AnchorPane>
