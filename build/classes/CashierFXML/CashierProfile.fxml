<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@../css/cashier.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.cashierProfile">

    <children>

        <!-- NAV BAR -->
        <HBox fx:id="navPanel" prefHeight="80" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <children>
                <ImageView fx:id="navLogo" fitHeight="60" fitWidth="60" preserveRatio="true">
                    <image>
                        <Image url="@../image/image6.jpg" />
                    </image>
                </ImageView>

                <Label fx:id="navText" styleClass="nav-item logo-text" text="Melynal Trading" />

                <Label fx:id="homeBtn" onMouseClicked="#homeHandleBtn" styleClass="nav-item" text="Home">
                    <padding>
                        <Insets left="50" />
                    </padding>
                </Label>

                <Label styleClass="nav-item" text="Products" />

                <Label fx:id="aboutBtn" onMouseClicked="#aboutHandleBtn" styleClass="nav-item" text="About">
                    <padding>
                        <Insets right="80" />
                    </padding>
                </Label>

                <Label fx:id="profileBtn" onMouseClicked="#profileHandleBtn" styleClass="nav-item active" text="Profile" />
                <Label fx:id="logoutBtn" onMouseClicked="#handleLogoutBtn" styleClass="nav-item" text="Logout" />
            </children>
        </HBox>

        <!-- PROFILE BODY -->
        <VBox fx:id="hero" alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to right, #a92b6c, #ec5f9b);" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="80">

            <children>
                <!-- PROFILE CARD WITH IMAGE AND INFO SIDE BY SIDE -->
                <HBox alignment="CENTER_LEFT" spacing="40" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15,0,0,5);">

                    <!-- PROFILE IMAGE -->
                    <ImageView fx:id="profileImage" fitHeight="140" fitWidth="140" preserveRatio="true" style="-fx-background-radius: 70px; -fx-border-radius: 70px; -fx-border-color: white; -fx-border-width: 4;">
                        <image>
                            <Image url="@../image/icons8-profile-50.png" />
                        </image>
                    </ImageView>

                    <!-- LOGGED-IN USER INFO -->
                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="nameLabel" styleClass="profile-name" text="John Doe" />
                        <Label fx:id="emailLabel" styleClass="profile-email" text="john@example.com" />
                        <Label fx:id="roleLabel" styleClass="profile-role" text="Cashier" />
                    </VBox>
                </HBox>
            </children>

        </VBox>
    </children>
</AnchorPane>
