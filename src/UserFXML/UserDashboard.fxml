<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/user.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UserController.userDashboard">

    <!-- Top Navigation Bar -->
    <HBox fx:id="navPanel" alignment="CENTER_LEFT" prefHeight="80.0" spacing="16.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Logo -->
        <ImageView fx:id="navLogo" fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
            <image>
                <Image url="@../image/image6.jpg" />
            </image>
            <HBox.margin>
                <Insets left="22.0" />
            </HBox.margin>
        </ImageView>

        <Label styleClass="brand-title" text="Melynal Trading" />

        <Label fx:id="homeBtn" onMouseClicked="#homeHandleBtn" styleClass="nav-item" text="Home" />
        <Label onMouseClicked="#productHandleBtn" styleClass="nav-item" text="Products" />
        <Label fx:id="aboutBtn" onMouseClicked="#aboutHandleBtn" styleClass="nav-item" text="About" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="profileBtn" onMouseClicked="#profileHandlebtn" styleClass="nav-item" text="Profile" />
        <Label fx:id="logoutBtn" onMouseClicked="#handleLogoutBtn" styleClass="nav-item" text="Logout">
            <HBox.margin>
                <Insets right="22.0" />
            </HBox.margin>
        </Label>
    </HBox>

    <!-- Hero Section -->
    <VBox fx:id="hero" alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="80.0">

        <!-- Center Big Logo -->
        <ImageView fx:id="heroLogo" fitHeight="180" fitWidth="180" preserveRatio="true">
            <image>
                <Image url="@../image/image6.jpg" />
            </image>
        </ImageView>

        <Label styleClass="title" text="Welcome to Melynal Trading" />
        <Label styleClass="subtitle" text="Be Beautiful, Be Pocketful, Be A Blessing" />
        <Label styleClass="description" text="Your trusted source for quality cosmetics and beauty products since 2017" />
        <Button onMouseClicked="#shopHandlebtn" styleClass="shop-btn" text="Shop Now" />
    </VBox>

</AnchorPane>
