<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdminController.adminUser">

    <children>

        <!-- ================= SIDEBAR ================= -->
        <VBox fx:id="panel" alignment="TOP_CENTER" fillWidth="true" prefWidth="220.0" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

            <children>
                <ImageView fx:id="logo" fitHeight="140.0" fitWidth="140.0" preserveRatio="true">
                    <image>
                        <Image url="@../image/image6.jpg" />
                    </image>
                </ImageView>

                <Label fx:id="textPanel" alignment="CENTER" maxWidth="Infinity" text="Admin Panel" />

                <VBox maxWidth="Infinity" spacing="6.0">
                    <children>
                        <Button fx:id="dashboard" maxWidth="Infinity" onAction="#dashboardButtonAction" styleClass="nav-btn" text="Dashboard">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image><Image url="@../image/icons8-dashboard-24.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="productBtn" maxWidth="Infinity" onAction="#productButtonAction" styleClass="nav-btn" text="Products">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image><Image url="@../image/icons8-products-24.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="salesBtn" maxWidth="Infinity" onMouseClicked="#saleHandleBtn" styleClass="nav-btn" text="Sales">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image><Image url="@../image/icons8-sales-24.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="userBtn" maxWidth="Infinity" onAction="#userButtonAction" styleClass="nav-btn" text="Users">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image><Image url="@../image/icons8-user-24.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#logoutButtonAction" styleClass="nav-btn1" text="Logout">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image><Image url="@../image/icons8-logout-24.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>

            </children>
        </VBox>

        <!-- ================= TITLE ================= -->
        <Label layoutX="240" layoutY="20" styleClass="page-title" text="User Management" />

        <!-- ================= FORM LEFT ================= -->
        <TextField fx:id="nameField" layoutX="240.0" layoutY="59.0" prefWidth="200" promptText="Full Name" />
        <TextField fx:id="emailField" layoutX="240.0" layoutY="103.0" prefWidth="200" promptText="Email" />
        <TextField fx:id="usernameField" layoutX="240.0" layoutY="147.0" prefWidth="200" promptText="Username" />

        <TextField fx:id="addressField" layoutX="240.0" layoutY="191.0" prefWidth="200" promptText="Address" />
        <TextField fx:id="phoneField" layoutX="240.0" layoutY="235.0" prefWidth="200" promptText="Phone" />

        <ComboBox fx:id="roleCombo" layoutX="240.0" layoutY="279.0" prefHeight="27.0" prefWidth="150" promptText="Role" />
        <ComboBox fx:id="statusCombo" layoutX="403.0" layoutY="280.0" prefWidth="150" promptText="Status" />

        <!-- ================= IMAGE ================= -->
        <ImageView fx:id="profileImage" fitHeight="90" fitWidth="90" layoutX="600" layoutY="70" styleClass="image-preview" />
        <Button layoutX="585" layoutY="170" onAction="#chooseImage" styleClass="btn-secondary" text="Choose Image" />

        <!-- ================= CRUD BUTTONS ================= -->
        <Button layoutX="240.0" layoutY="333.0" onAction="#addUser" prefWidth="70" styleClass="btn-primary" text="Add" />
        <Button layoutX="320.0" layoutY="332.0" onAction="#updateUser" prefHeight="39.0" prefWidth="79.0" styleClass="btn-secondary" text="Update" />
        <Button layoutX="410.0" layoutY="333.0" onAction="#deleteUser" prefWidth="70" styleClass="btn-danger" text="Delete" />

        <!-- ================= TABLE (ONLY ONE) ================= -->
        <TableView fx:id="ViewUser" layoutX="240.0" layoutY="377.0" prefHeight="220" prefWidth="740.0">

            <columns>
                <TableColumn fx:id="id" prefWidth="50" text="ID" />
                <TableColumn fx:id="name" prefWidth="120" text="Name" />
                <TableColumn fx:id="email" prefWidth="140" text="Email" />
                <TableColumn fx:id="uname" prefWidth="110" text="Username" />
                <TableColumn fx:id="role" prefWidth="80" text="Role" />
                <TableColumn fx:id="status" prefWidth="80" text="Status" />
                <TableColumn fx:id="phone" prefWidth="100" text="Phone" />
                <TableColumn fx:id="address" prefWidth="160" text="Address" />
            </columns>

        </TableView>

    </children>
</AnchorPane>
