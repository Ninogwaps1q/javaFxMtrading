<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="AnchorPane" prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdminController.AdminDashboard">

    <children>

        <!-- Sidebar -->
        <VBox fx:id="panel" alignment="TOP_CENTER" fillWidth="true" prefWidth="220.0" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

            <ImageView fx:id="logo" fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../image/image6.jpg" />
                </image>
            </ImageView>

            <Label fx:id="textPanel" alignment="CENTER" maxWidth="Infinity" text="Admin Panel" />

            <VBox maxWidth="Infinity" spacing="6.0">
                <children>
                    <Button fx:id="dashboard" maxWidth="Infinity" onAction="#dashboardButtonAction" styleClass="nav-btn" text="Dashboard">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../image/icons8-dashboard-24.png" />
                                </image>
                                <viewport>
                                    <Rectangle2D />
                                </viewport>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="productBtn" maxWidth="Infinity" onAction="#productButtonAction" styleClass="nav-btn" text="Products">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../image/icons8-products-24.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="salesBtn" maxWidth="Infinity" onAction="#orderButtonAction" onMouseClicked="#saleHandleBtn" styleClass="nav-btn" text="Sales">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../image/icons8-sales-24.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="userBtn" maxWidth="Infinity" onAction="#userButtonAction" styleClass="nav-btn" text="Users">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../image/icons8-user-24.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#logoutButtonAction" styleClass="nav-btn1" text="Logout">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../image/icons8-logout-24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>

        <!-- Main content -->
        <VBox spacing="14.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label styleClass="page-title" text="Dashboard" />

                <HBox spacing="12.0">
                    <children>
                        <VBox maxWidth="Infinity" spacing="8.0" styleClass="surface summary-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="summary-title" text="Total Products" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" opacity="0.35" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../image/icons8-product-24.png" />
                                            </image>
                                        </ImageView>
                                        <Label fx:id="totalProductsLabel" styleClass="summary-value" text="0" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox maxWidth="Infinity" spacing="8.0" styleClass="surface summary-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="summary-title" text="Total Orders" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" opacity="0.35" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../image/icons8-order-48.png" />
                                            </image>
                                        </ImageView>
                                        <Label fx:id="totalOrdersLabel" styleClass="summary-value" text="0" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox maxWidth="Infinity" spacing="8.0" styleClass="surface summary-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="summary-title" text="Total Customers" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" opacity="0.35" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../image/icons8-user-30.png" />
                                            </image>
                                        </ImageView>
                                        <Label fx:id="totalCustomersLabel" styleClass="summary-value" text="0" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox maxWidth="Infinity" spacing="8.0" styleClass="surface summary-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="summary-title" text="Total Revenue" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label fx:id="totalRevenueLabel" styleClass="summary-value" text="PHP 0.00" />
                                        <Region prefHeight="53.0" prefWidth="59.0" HBox.hgrow="ALWAYS" />
                                        <ImageView fitHeight="24.0" fitWidth="24.0" opacity="0.35" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../image/icons8-sales-24.png" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10.0" styleClass="surface dashboard-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label styleClass="section-title" text="Recent Orders" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="viewAllBtn" onAction="#viewAllOrdersAction" prefWidth="96.0" styleClass="btn-primary" text="View All" />
                                    </children>
                                </HBox>

                                <TableView fx:id="recentOrdersTable" prefHeight="373.0" prefWidth="983.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="recentOrderIdCol" prefWidth="100.0" text="Order ID" />
                                        <TableColumn fx:id="recentCustomerCol" prefWidth="240.0" text="Customer" />
                                        <TableColumn fx:id="recentAmountCol" prefWidth="138.0" text="Amount" />
                                        <TableColumn fx:id="recentStatusCol" prefWidth="135.0" text="Status" />
                                        <TableColumn fx:id="recentDateCol" prefWidth="125.0" text="Date" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</AnchorPane>
